__pycache__/
*.pyc
build/
dist/
*.spec
config/
.delegate/
archive/

# Auto-archive backups (created by /backup skill)
backups/

# Test fixtures generated at test time
tests/fixtures/
tests/.pytest_cache/

# Per-installation id (generated at runtime)
config/.installation_id

# Crash dumps (generated at runtime, contain sanitized stack traces)
config/crashes/

# Claude Code session artifacts (auto-managed; should not be committed)
.claude/

# Stray installer test dirs (defense against bash $TEMP path mishandling)
TestVideoEditor/
VE_*/

# IDE
.vscode/
.idea/
*.swp
